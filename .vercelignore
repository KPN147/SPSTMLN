# Only upload files required to build the static game.
# Git ignore rules alone are not the deployment boundary.
/*
!/src/
!/public/
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/vercel.json

# Never include local secrets even inside an allowed directory.
**/.env
**/.env.*
**/*.local
**/*.local.json
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/credentials*.json
**/service-account*.json
**/service_account*.json
**/*-firebase-adminsdk-*.json
**/private/
**/secrets/
**/*.log
